# PostgreSQL connection string (Supabase)
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# Groq API
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Resend email (for sending approved proposals to the client)
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=Greenscape Pro [proposals@mail.tokgrowthpartner.com]

# Comma-separated list of allowed CORS origins (no wildcard in production)
CORS_ORIGINS=http://localhost:5173
